(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	# The edge terminates TLS; reverse_proxy would otherwise forward the plain-HTTP
	# scheme it received, and Django would build http:// presigned URLs.
	reverse_proxy /spaces/* prod-plane-dhdtech-io-space:3000 {
		header_up X-Forwarded-Proto https
	}

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* prod-plane-dhdtech-io-admin:3000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /live/* prod-plane-dhdtech-io-live:3000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /api/* prod-plane-dhdtech-io-api:8000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /auth/* prod-plane-dhdtech-io-api:8000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /static/* prod-plane-dhdtech-io-api:8000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /{$BUCKET_NAME}/* prod-plane-dhdtech-io-minio:9000 {
		header_up X-Forwarded-Proto https
	}
	reverse_proxy /{$BUCKET_NAME} prod-plane-dhdtech-io-minio:9000 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy /* prod-plane-dhdtech-io-web:3000 {
		header_up X-Forwarded-Proto https
	}
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}